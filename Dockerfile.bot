FROM node:22-alpine AS deps

WORKDIR /app

COPY bot/package.json bot/package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY bot/package.json ./package.json
COPY bot/src ./src

USER node

CMD ["node", "src/index.js"]
